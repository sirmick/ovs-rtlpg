# The intended differences of the object model (RTLPlayground feat/om)
# against the reference (53ee574), with --new-om naming the objects moved.
# `<scenario glob> <result glob> [-/RE/|+/RE/]...  # why`: a line's -/RE/
# and +/RE/ are the lines a result may lose and gain (oldnew.py).
# Each object migration adds its own.

# port.N (dab5d13): the boot no longer prints the EEE setup per port, nor
# the port table (stat's), and so no longer reads the STAT counters at boot
* *boot -/EEE on for \d+ speed \w+/ -/EEE can't be enabled for SFP port \d+/
* *boot -/Verifying PHY settings:\n\nPort\tState\tLink\t[^\n]*(\n\d+\t(On|Off|SFP IN|NO SFP)\t[^\n]*)+/
# The STAT block: the boot's port table reads it, the new boot doesn't. A
# scenario that reads counters (stat, /ports.json, /traffic.json and
# /counters.json by value) has all three on both images; they hold the last
# port read, and get reads the ports in front order, stat in logical order:
# on the SWGT024 another port's (on the 8x the same)
* reg 0f6[048] -/[0-9a-f]{8}/ +/<absent>/
vlan,cli,web,loop,sfp,flaps reg 0f6[048] -/[0-9a-f]{8}/ +/[0-9a-f]{8}/

# The history holds what was typed: the new image the translated lines
# (translate.py), and not the old ones they stand for (P4-1: sys web mgmt
# dns ntp syslog's too)
* *cli history +/(get|set) \S+( .*)?|apply|discard/ -/(stat|mtu .*|pvid .*|port .*|isolate .*|ingress .*|eee .*|version|temp|(hostname|ip|gw|netmask|session|passwd)( .*)?|led .*|vlan \d+ mgmt|dns server.*|ntp (on|off|server|interval|timezone|dst).*|syslog .*)/
* *web GET /cmd_log +/(get|set) \S+( .*)?|apply|discard/ -/(stat|mtu .*|pvid .*|port .*|isolate .*|ingress .*|eee .*|version|temp|(hostname|ip|gw|netmask|session|passwd)( .*)?|led .*|vlan \d+ mgmt|dns server.*|ntp (on|off|server|interval|timezone|dst).*|syslog .*)/
# state.mgmt, state.ntp (P5-3): ip, gw, netmask and time with no argument
# print nothing any more; get state.mgmt and state.ntp stand for them
* *cli history -/(ip|gw|netmask|time)/
* *web GET /cmd_log -/(ip|gw|netmask|time)/

# P3C: the session cookie is HttpOnly (the UI never reads it; a script
# injected into a page can't take it either)
* *web POST /login -/Set-Cookie: session=<session>; SameSite=Strict/ +/Set-Cookie: session=<session>; SameSite=Strict; HttpOnly/

# A page gone on the new image is read there with get, on the console: the
# HTTP frames to the host are fewer. With port: /eee.json and
# /isolation.json, in web only
web frames * tcp/80

# The config scenario saves the settings as each image takes them: the old
# command text, or set lines and an apply (Run.convert(), the stand-in for
# rtlpg_client.py convert) - DESIGN 18: the config region differs by design
config *web GET /config -/(stat|mtu .*|pvid .*|port .*|isolate .*|ingress .*|eee .*|(hostname|ip|gw|netmask|session|passwd)( .*)?|led .*|vlan \d+ mgmt|dns server.*|ntp (on|off|server|interval|timezone|dst).*|syslog .*)/ +/set \S+ .*|apply/
config flash config -/(stat|mtu .*|pvid .*|port .*|isolate .*|ingress .*|eee .*|(hostname|ip|gw|netmask|session|passwd)( .*)?|led .*|vlan \d+ mgmt|dns server.*|ntp (on|off|server|interval|timezone|dst).*|syslog .*)|<then not blank: sha256 \w+>/ +/set \S+ .*|apply|<then not blank: sha256 \w+>/
config *boot +/ok/		# the boot runs them: an ok per set line and the apply

# mgmt (P4-1): the management VLAN is mgmt.vlan, no longer in /vlanlist.json
* *web GET /vlanlist.json -/\{"mgmt":\d+,"vlan":.*/ +/\{"vlan":.*/

# P3B (the binary saved config, om/core 23580ab)
# no seeding: a blank saved sector boots on the default and stays blank
* *boot -/Written default config to flash/
# where the port table ends the boot (the SWGT024), the two go as one run
* *boot -/Verifying PHY settings:\n\nPort\tState\tLink\t[^\n]*(\n\d+\t(On|Off|SFP IN|NO SFP)\t[^\n]*)+\nWritten default config to flash/
upload,stp_upload *flash config 0x7f000 -/0x7f000\.\.0x7fffe sha256 \w+/ +/0x7f000\.\.0x7fffe blank/
# the default config replays (fileadder fixed, e4b6c83): config.txt's
# 192.168.10.247 where the old compact image booted on the built-in .2.2
cli *cli ip -/state\.mgmt\.ip 192\.168\.2\.2/ +/state\.mgmt\.ip 192\.168\.10\.247/	# factory default fixed (e4b6c83)
cli *cli gw -/state\.mgmt\.gateway 192\.168\.2\.22/ +/state\.mgmt\.gateway 192\.168\.10\.1/	# factory default fixed (e4b6c83)
web *web GET /information.json -/state\.mgmt\.(ip|gateway) [\d.]+|state\.sys\.uptime_s \d+/ +/state\.mgmt\.(ip|gateway) [\d.]+|state\.sys\.uptime_s \d+/	# factory default fixed (e4b6c83); the boot's length
lldp *lldp frames -/\s*mgmt\saddr\slen\s12:\s0501c0a80202010000000000/ +/\s*mgmt\saddr\slen\s12:\s0501c0a80af7010000000000/	# factory default fixed (e4b6c83)
# the boot loads the binary default: about a second longer (the seconds counter)
* reg 06f4 -/[0-9a-f]{8}/ +/[0-9a-f]{8}/
# history, /cmd_log and /cmd_log_clear are gone (the ring stays the editor's recall)
* *cli history +/Error: Unknown command/ -/.+/
* *web GET /cmd_log -/.+/ +/HTTP\/1\.1 404 Not found|Connection: close|Content-Type: text\/html|<71 bytes, sha256 47f4d797b2e4b273>|/
* *web GET /cmd_log_clear -/.+/ +/HTTP\/1\.1 404 Not found|Connection: close|Content-Type: text\/html|<71 bytes, sha256 47f4d797b2e4b273>|/
# P3L: a reply to the web is not on the console too (the old image's web
# commands printed theirs there: vlan's set by POST /cmd)
vlan *console -/vlan: 0x[0-9a-f]{4}, members: 0x[0-9a-f]{4}, tagged: 0x[0-9a-f]{4}/ +/<absent>/
# GET /config is get -s: the saved config's path lines and ok, or err get: blank
# (not on the console, P3L)
* *web GET /config -/.*/ +/err get: blank|ok|[a-z_]+\.[\w.]+ .*|/
web *web GET /index.html -/<\d+ bytes, sha256 \w+>/ +/<\d+ bytes, sha256 \w+>/	# the old text save's button goes
web *web GET /app.js -/<\d+ bytes, sha256 \w+>/ +/<\d+ bytes, sha256 \w+>/	# the old text save's code goes
# config: saved with save by POST /cli (oldnew.py post_config); the objects
# not on the model yet run and are dropped by the save, so after the power
# cut loop detection differs until P4-5 (loop); VLAN 10 is saved since P4-2,
# STP since P4-4. The new image now boots after the cut.
config *web POST /config -/.*/ +/.*/
config *console -/.*/ +/.*/
config flash config -/.*/ +/.*/
config reg 10[679][0-9a-f]
config reg 108c
config frames * rldp
config frames * stp
config frames * tcp/80
config reg 7850
config *cli loop show
config *boot -/.*/ +/.*/

# state.stp (P5-4): with STP off the old `stp status` printed that alone;
# get state.stp shows the state whatever STP's config (stp.json did too).
# Only gained lines: a value that differs is still a difference
* *cli stp status +/state\.stp\.\S+ .*/
# /stpcnt.json is gone (P5-4): the stp scenario reads it with get, so it
# sends fewer HTTP frames to the host
stp frames * tcp/80

# /ports.json, /traffic.json, /counters.json and /l2.json are gone (P5-5):
# the scenarios read them with get, so they send fewer HTTP frames to the host
vlan,sfp,flaps,l2_big,lacp_l2 frames * tcp/80
# get state.l2 walks the table once, to the search that wraps; the old pages
# stopped at outbuf's room, a page at a time: the table registers' last
# values differ (the values read are the same)
l2_big,lacp_l2 reg 5cac
l2_big,lacp_l2 reg 5cb0
l2_big,lacp_l2 reg 5ccc
l2_big,lacp_l2 reg 5cd0
# vlan.V (P4-2, om/core): /vlan.json and /vlanlist.json go (read by value with
# get); a POST /cmd vlan goes as set lines and an apply (oldnew.py post_cmd):
# vlan_create()'s line on the old console, the ok lines on the new
web,vlan *console -/vlan: 0x[0-9a-f]{4}, members: 0x[0-9a-f]{4}, tagged: 0x[0-9a-f]{4}/ +/ok/
# the pages read with get: fewer HTTP frames (as port's in web)
vlan,lldp frames * tcp/80

# P3J (om/core-p3j 179eafd): the boot writes every port's settings and the LEDs once, at their
# defaults too (a soft reset keeps the chip and the PHYs as they were), so the PHYs' autoneg
# registers and the LED SW_EN registers are written where the old image left them at reset; and
# the boot's L2 flush takes the static entries and the CPU's too (FLUSH_MODE bit 2)
* reg 53d4 -/[0-9a-f]{8}/ +/[0-9a-f]{8}/
* reg 53dc -/00000000/ +/00000004/
* reg 655[48] -/<absent>/ +/00000000/
* phy *.07.00[0-2]0 -/<absent>/ +/[0-9a-f]{4}/
* phy *.1f.a412 -/<absent>/ +/[0-9a-f]{4}/
# and /ports.json then reads each copper port's advertisement from what the boot wrote (speed
# auto: every mode the port has), where the old image's untouched PHYs read none in rtlsim
* *web GET /ports.json -/raw\.port\.\d+\.adv none/ +/raw\.port\.\d+\.adv [0-9a-z,]+/
# and LLDP's 802.3 MAC/PHY TLV says autonegotiation supported and on, with those modes
lldp *lldp frames -/\s*org len 9: 00120f\/1 010000000a/ +/\s*org len 9: 00120f\/1 036c01000a/
# lag.L (P4-3, om/lag): the boot writes every trunk empty and every hash the
# default (lacp_init: the hardware is the config's defaults); the old boot
# left them (the sim's reset 0: an unused LAG's hash read none)
* reg 4f3[8c] -/<absent>/ +/[0-9a-f]{8}/
* reg 4f4[048c] -/<absent>/ +/[0-9a-f]{8}/
* reg 4f5[04] -/<absent>/ +/[0-9a-f]{8}/
* *web GET /lag.json -/lag\.[1-4]\.hash none/ +/lag\.[1-4]\.hash dip,dmac,dport,sip,smac,sport/
# port_lag_members_set() no longer prints; the set lines and apply answer
# sooner than the old lag command, so the link line lands a result earlier
lacp* *console -/port_lag_members_set, lag: \d+, members: 0x[0-9a-f]{4}|<new link: [0-9a-f]+, was [0-9a-f]+>|/ +/<absent>|<new link: [0-9a-f]+, was [0-9a-f]+>|/
# /lag.json read with get: fewer HTTP frames
lacp frames * tcp/80
# stp (P4-4): stp on is apply's, the cfg job's a step after the command, so
# the tree starts a tick later: the link line lands a result later, and the
# BPDUs sent and the ages read a BPDU and a tick behind
stp* *console -/<new link: [0-9a-f]+, was [0-9a-f]+>|/ +/<new link: [0-9a-f]+, was [0-9a-f]+>|/
stp *cli stp status -/state\.stp\.(port|lag)\.\d\.(bpdu_age_ms|tx_bpdu) \d+/ +/state\.stp\.(port|lag)\.\d\.(bpdu_age_ms|tx_bpdu) \d+/
stp *web GET /stpcnt.json -/state\.stp\.(port|lag)\.\d\.(bpdu_age_ms \d+ s|tx_bpdu \d+)/ +/state\.stp\.(port|lag)\.\d\.(bpdu_age_ms \d+ s|tx_bpdu \d+)/
# STP off writes every port forwarding, the power-on 0xfffff: the old left
# the logical ports that aren't front ports disabled (the SWGT024's 0-2)
stp* reg 5310 -/000fffc0/ +/000fffff/
