# The intended differences of the object model (RTLPlayground feat/om)
# against the reference (53ee574), with --new-om naming the objects moved.
# `<scenario glob> <result glob> [-/RE/|+/RE/]...  # why`: a line's -/RE/
# and +/RE/ are the lines a result may lose and gain (oldnew.py).
# Each object migration adds its own.

# port.N (dab5d13): the boot no longer prints the EEE setup per port, nor
# the port table (stat's), and so no longer reads the STAT counters at boot
* *boot -/EEE on for \d+ speed \w+/ -/EEE can't be enabled for SFP port \d+/
* *boot -/Verifying PHY settings:\n\nPort\tState\tLink\t[^\n]*(\n\d+\t(On|Off|SFP IN|NO SFP)\t[^\n]*)+/
# The STAT block: the boot's port table reads it, the new boot doesn't. A
# scenario that reads counters (stat, /ports.json, /traffic.json and
# /counters.json by value) has all three on both images; they hold the last
# port read, and get reads the ports in front order, stat in logical order:
# on the SWGT024 another port's (on the 8x the same)
* reg 0f6[048] -/[0-9a-f]{8}/ +/<absent>/
vlan,cli,web,loop,sfp,flaps reg 0f6[048] -/[0-9a-f]{8}/ +/[0-9a-f]{8}/

# port.N against /ports.json by value: 53ee574 reads the MTU register, 0 in
# rtlsim (the boot never writes it); feat/om's port.N.mtu is the default,
# 16383, which its boot doesn't write either (asked: rtlsim's reset value or
# a feat/om bug)
* *web GET /ports.json -/port\.\d+\.mtu 0/ +/port\.\d+\.mtu 16383/

# The history holds what was typed: the new image the translated lines
# (translate.py), and not the old ones they stand for
* *cli history +/(get|set) \S+( .*)?|apply|discard/ -/(stat|mtu .*|pvid .*|port .*|isolate .*|ingress .*|eee .*)/
* *web GET /cmd_log +/(get|set) \S+( .*)?|apply|discard/ -/(stat|mtu .*|pvid .*|port .*|isolate .*|ingress .*|eee .*)/

# A page gone on the new image is read there with get, on the console: the
# HTTP frames to the host are fewer
* frames * tcp/80

# The config scenario saves the settings as each image takes them: the old
# command text, or set lines and an apply (Run.convert(), the stand-in for
# rtlpg_client.py convert) - DESIGN 18: the config region differs by design
config *web GET /config -/(stat|mtu .*|pvid .*|port .*|isolate .*|ingress .*|eee .*)/ +/set \S+ .*|apply/
config flash config -/(stat|mtu .*|pvid .*|port .*|isolate .*|ingress .*|eee .*)|<then not blank: sha256 \w+>/ +/set \S+ .*|apply|<then not blank: sha256 \w+>/
config *boot +/ok/		# the boot runs them: an ok per set line and the apply
